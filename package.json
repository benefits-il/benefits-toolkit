{
  "name": "benefits-toolkit",
  "displayName": "Benefit's Toolkit",
  "description": "Quality-of-life tools for Claude Code: RTL chat, sounds, a conversation manager and viewer, window colors and HTML in your browser. Part of Benefits, the course that teaches you to work right with AI (benefits-il.dev).",
  "version": "0.7.1",
  "publisher": "benakiva",
  "author": {
    "name": "Ben Akiva"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/benefits-il/benefits-toolkit.git"
  },
  "homepage": "https://github.com/benefits-il/benefits-toolkit#readme",
  "bugs": {
    "url": "https://github.com/benefits-il/benefits-toolkit/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "rtl",
    "hebrew",
    "chat history",
    "notifications",
    "sounds"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#022C22",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "benefit-sidebar",
          "title": "Benefit's Toolkit",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "benefit-sidebar": [
        {
          "type": "webview",
          "id": "benefit.brandView",
          "name": "Benefits",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Benefits",
          "initialSize": 10
        },
        {
          "id": "benefit.chatsView",
          "name": "Claude Chats",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Claude Chats",
          "when": "config.benefit.chats.enabled"
        },
        {
          "type": "webview",
          "id": "benefit.soundsView",
          "name": "Alerts",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Alerts"
        },
        {
          "type": "webview",
          "id": "benefit.colorsView",
          "name": "Colors",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Colors",
          "when": "config.benefit.windowColor.enabled"
        },
        {
          "type": "webview",
          "id": "benefit.toolkitView",
          "name": "Toolkit",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Toolkit"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "benefit.chatsView",
        "when": "workbenchState == empty",
        "contents": "No folder is open, so there is no project to scope to.\n[Show All Projects](command:benefit.chats.toggleScope)\n[Open Folder](command:workbench.action.files.openFolder)"
      },
      {
        "view": "benefit.chatsView",
        "when": "workbenchState != empty",
        "contents": "No conversations for this project yet.\nThe list is scoped to the folder open in this window.\n[Show All Projects](command:benefit.chats.toggleScope)\n[Refresh](command:benefit.chats.refresh)"
      }
    ],
    "commands": [
      { "command": "benefit.rtl.toggle", "title": "RTL: Toggle", "category": "Benefit" },
      { "command": "benefit.rtl.enableActive", "title": "RTL: Enable (Active mode)", "category": "Benefit" },
      { "command": "benefit.rtl.enableAlways", "title": "RTL: Enable (Always)", "category": "Benefit" },
      { "command": "benefit.rtl.enableAuto", "title": "RTL: Enable (Auto-detect)", "category": "Benefit" },
      { "command": "benefit.rtl.disable", "title": "RTL: Disable", "category": "Benefit" },
      { "command": "benefit.rtl.status", "title": "RTL: Show Status", "category": "Benefit" },

      { "command": "benefit.sounds.install", "title": "Sounds: Install Hooks", "category": "Benefit" },
      { "command": "benefit.sounds.uninstall", "title": "Sounds: Uninstall Hooks", "category": "Benefit" },
      { "command": "benefit.sounds.chooseSounds", "title": "Sounds: Choose Sound Variants", "category": "Benefit" },
      { "command": "benefit.sounds.test", "title": "Sounds: Test Playback", "category": "Benefit" },
      { "command": "benefit.sounds.status", "title": "Sounds: Show Status", "category": "Benefit" },
      { "command": "benefit.popup.test", "title": "Popup: Test", "category": "Benefit" },

      { "command": "benefit.windowColor.pick", "title": "Window Color: Pick", "category": "Benefit" },
      { "command": "benefit.windowColor.clear", "title": "Window Color: Clear", "category": "Benefit" },

      { "command": "benefit.html.openInBrowser", "title": "Open in External Browser", "category": "Benefit", "icon": "$(link-external)" },

      { "command": "benefit.chats.refresh", "title": "Refresh", "category": "Benefit Chats", "icon": "$(refresh)" },
      { "command": "benefit.chats.rename", "title": "Rename", "category": "Benefit Chats", "icon": "$(edit)" },
      { "command": "benefit.chats.archive", "title": "Archive", "category": "Benefit Chats", "icon": "$(archive)" },
      { "command": "benefit.chats.restore", "title": "Restore from Archive", "category": "Benefit Chats" },
      { "command": "benefit.chats.delete", "title": "Delete", "category": "Benefit Chats", "icon": "$(trash)" },
      { "command": "benefit.chats.search", "title": "Search Conversations", "category": "Benefit Chats", "icon": "$(search)" },
      { "command": "benefit.chats.export", "title": "Export to Markdown", "category": "Benefit Chats" },
      { "command": "benefit.chats.view", "title": "View Conversation", "category": "Benefit Chats" },
      { "command": "benefit.chats.toggleSort", "title": "Toggle Sort Order", "category": "Benefit Chats", "icon": "$(sort-precedence)" },
      { "command": "benefit.chats.toggleGroupBy", "title": "Toggle Group By (Date / Project)", "category": "Benefit Chats" },
      { "command": "benefit.chats.toggleArchived", "title": "Show/Hide Archived", "category": "Benefit Chats", "icon": "$(eye)" },
      { "command": "benefit.chats.toggleScope", "title": "Toggle Scope (Current Project / All)", "category": "Benefit Chats" },
      { "command": "benefit.chats.scopeToAll", "title": "Scope: This Project — click for All Projects", "category": "Benefit Chats", "icon": "$(filter-filled)" },
      { "command": "benefit.chats.scopeToCurrent", "title": "Scope: All Projects — click for This Project", "category": "Benefit Chats", "icon": "$(filter)" },
      { "command": "benefit.chats.statusBarRename", "title": "Rename Active Conversation", "category": "Benefit Chats" }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "benefit.html.openInBrowser",
          "when": "config.benefit.htmlOpen.enabled && (resourceExtname == .html || resourceExtname == .htm)",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "benefit.html.openInBrowser",
          "when": "config.benefit.htmlOpen.enabled && (resourceExtname == .html || resourceExtname == .htm)",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        { "command": "benefit.chats.refresh", "when": "view == benefit.chatsView", "group": "navigation@1" },
        { "command": "benefit.chats.search", "when": "view == benefit.chatsView", "group": "navigation@2" },
        { "command": "benefit.chats.scopeToAll", "when": "view == benefit.chatsView && !benefit.chats.scopeAll", "group": "navigation@3" },
        { "command": "benefit.chats.scopeToCurrent", "when": "view == benefit.chatsView && benefit.chats.scopeAll", "group": "navigation@3" },
        { "command": "benefit.chats.toggleSort", "when": "view == benefit.chatsView", "group": "navigation@4" },
        { "command": "benefit.chats.toggleArchived", "when": "view == benefit.chatsView", "group": "navigation@5" },
        { "command": "benefit.chats.toggleGroupBy", "when": "view == benefit.chatsView", "group": "1_view" }
      ],
      "view/item/context": [
        { "command": "benefit.chats.view", "when": "view == benefit.chatsView && viewItem == conversation", "group": "1_open@1" },
        { "command": "benefit.chats.rename", "when": "view == benefit.chatsView && viewItem == conversation", "group": "2_edit@1" },
        { "command": "benefit.chats.archive", "when": "view == benefit.chatsView && viewItem == conversation", "group": "2_edit@2" },
        { "command": "benefit.chats.restore", "when": "view == benefit.chatsView && viewItem == archived-conversation", "group": "2_edit@1" },
        { "command": "benefit.chats.export", "when": "view == benefit.chatsView && viewItem =~ /conversation/", "group": "3_actions@1" },
        { "command": "benefit.chats.delete", "when": "view == benefit.chatsView && viewItem =~ /conversation/", "group": "9_destroy@1" }
      ]
    },
    "configuration": {
      "title": "Benefit's Toolkit",
      "properties": {
        "benefit.rtl.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the RTL feature."
        },
        "benefit.rtl.mode": {
          "type": "string",
          "enum": ["off", "active", "always", "auto"],
          "default": "active",
          "enumDescriptions": [
            "RTL is off.",
            "Show a toggle button in the chat header; user toggles per session.",
            "Force RTL always on.",
            "Auto-detect RTL per message bubble."
          ],
          "description": "RTL mode."
        },
        "benefit.rtl.textFont": {
          "type": "string",
          "default": "",
          "description": "Optional custom font for chat text (leave empty to use default)."
        },
        "benefit.rtl.codeFont": {
          "type": "string",
          "default": "",
          "description": "Optional custom font for code blocks (leave empty to use default)."
        },
        "benefit.rtl.claudeCodePathOverride": {
          "type": "string",
          "default": "",
          "description": "Override path to the Claude Code extension folder. Leave empty for auto-detection."
        },
        "benefit.sounds.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Sounds feature."
        },
        "benefit.sounds.stopSound": {
          "type": "string",
          "enum": [
            "arrow.mp3",
            "bubble-pop.mp3",
            "cartoon-blink.mp3",
            "double-beep-alert.wav",
            "game-bonus-alt.mp3",
            "game-bonus.mp3",
            "interface-back.wav",
            "interface-select.wav",
            "intro-chime.mp3",
            "level-up.mp3",
            "magic-marimba.wav",
            "mission-complete.mp3",
            "notification-014.mp3",
            "notification-038.mp3",
            "notification-062.mp3",
            "notification-07.mp3",
            "notification-09.mp3",
            "notification-alert.mp3",
            "notification-bell.mp3",
            "notification-off.mp3",
            "notify-alt.wav",
            "notify-default.wav",
            "pay-chime.mp3",
            "quick-blip.mp3",
            "retro-game-notify.wav",
            "sci-fi-confirm.wav",
            "simple-whoosh.mp3",
            "stop-alt.wav",
            "stop-default.wav",
            "surprise-sting.mp3",
            "system-notification.mp3",
            "tile-reveal.wav"
          ],
          "default": "stop-default.wav",
          "description": "Sound file (from the bundled pool) to play when Claude finishes a message. Pick visually in the Sounds panel."
        },
        "benefit.sounds.notificationSound": {
          "type": "string",
          "enum": [
            "arrow.mp3",
            "bubble-pop.mp3",
            "cartoon-blink.mp3",
            "double-beep-alert.wav",
            "game-bonus-alt.mp3",
            "game-bonus.mp3",
            "interface-back.wav",
            "interface-select.wav",
            "intro-chime.mp3",
            "level-up.mp3",
            "magic-marimba.wav",
            "mission-complete.mp3",
            "notification-014.mp3",
            "notification-038.mp3",
            "notification-062.mp3",
            "notification-07.mp3",
            "notification-09.mp3",
            "notification-alert.mp3",
            "notification-bell.mp3",
            "notification-off.mp3",
            "notify-alt.wav",
            "notify-default.wav",
            "pay-chime.mp3",
            "quick-blip.mp3",
            "retro-game-notify.wav",
            "sci-fi-confirm.wav",
            "simple-whoosh.mp3",
            "stop-alt.wav",
            "stop-default.wav",
            "surprise-sting.mp3",
            "system-notification.mp3",
            "tile-reveal.wav"
          ],
          "default": "notify-default.wav",
          "description": "Sound file (from the bundled pool) to play when Claude needs your input. Pick visually in the Sounds panel."
        },
        "benefit.popup.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a small desktop popup, in the project's window color and name, when the agent finishes or needs you. Clicking it brings that project's window to the front. Never shown while that window is already focused."
        },
        "benefit.popup.onDone": {
          "type": "boolean",
          "default": true,
          "description": "Pop up when the agent finishes a reply."
        },
        "benefit.popup.onWaiting": {
          "type": "boolean",
          "default": true,
          "description": "Pop up when the agent is waiting for you (a permission prompt, a question, plan approval)."
        },
        "benefit.popup.seconds": {
          "type": "number",
          "default": 8,
          "minimum": 3,
          "maximum": 60,
          "description": "How many seconds the popup stays up. Hovering over it pauses the countdown."
        },
        "benefit.sounds.cleanupOnDeactivate": {
          "type": "boolean",
          "default": false,
          "description": "Remove sound hooks from ~/.claude/settings.json when the extension is deactivated."
        },
        "benefit.chats.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Chats feature."
        },
        "benefit.chats.scope": {
          "type": "string",
          "enum": ["currentWorkspace", "all"],
          "default": "currentWorkspace",
          "enumDescriptions": [
            "Show only conversations belonging to the folder open in this window.",
            "Show conversations from every project."
          ],
          "description": "Which conversations to list in the sidebar."
        },
        "benefit.chats.groupBy": {
          "type": "string",
          "enum": ["date", "project", "flat"],
          "default": "date",
          "description": "How to group conversations in the sidebar."
        },
        "benefit.chats.sortOrder": {
          "type": "string",
          "enum": ["newest", "oldest"],
          "default": "newest",
          "description": "Conversation sort order."
        },
        "benefit.chats.showArchived": {
          "type": "boolean",
          "default": false,
          "description": "Include archived conversations in the sidebar."
        },
        "benefit.chats.hideEmpty": {
          "type": "boolean",
          "default": true,
          "description": "Hide conversations that contain no real user/assistant messages."
        },
        "benefit.chats.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting a conversation."
        },
        "benefit.chats.showStatusBarRename": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar shortcut to rename the active conversation."
        },
        "benefit.chats.codeCopyButtons": {
          "type": "boolean",
          "default": true,
          "description": "Show a Copy button on every code block in the conversation viewer."
        },
        "benefit.chats.mdHeButton": {
          "type": "boolean",
          "default": true,
          "description": "Show an \"Open in md-he\" button on every message in the conversation viewer (opens the message at benefits-il.dev/md-he for comfortable reading)."
        },
        "benefit.windowColor.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Window Color feature (per-workspace title/activity/status bar colors)."
        },
        "benefit.htmlOpen.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Open HTML in External Browser feature."
        },
        "benefit.htmlOpen.browserPath": {
          "type": "string",
          "default": "",
          "description": "Full path to a browser executable (e.g. chrome.exe). Leave empty to use the system default browser."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "package": "vsce package",
    "test": "node --test --import tsx test/**/*.test.ts"
  },
  "dependencies": {
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.12.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
